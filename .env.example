# CodeIgniter Environment
CI_ENVIRONMENT = development

# Base URL
app.baseURL = 'http://localhost:8080/'

# Database (Production on Ouvaton)
database.default.hostname = localhost
database.default.database = kermesse_prod
database.default.username = user
database.default.password = secret
database.default.DBDriver = MySQLi
database.default.DBPrefix =

# Ops Security
# Clé lue par OpsAuthFilter (Config\Kermesse::$opsMigrationHmacSecret).
# En production, écrite par sync-production-env.sh depuis le secret GitHub
# OPS_MIGRATION_HMAC_SECRET. ≥ 32 caractères — générer avec `openssl rand -hex 32`.
kermesse.opsMigrationHmacSecret = 'change_me_to_a_secure_random_string'

# Mail
email.fromEmail = no-reply@kermesse.test
email.fromName  = Kermesse
