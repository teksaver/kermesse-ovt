# Kermesse environment example.
# Copy this file to `.env` locally or on the target environment and fill values there.
# Never commit a real `.env` or `.env.next` file. Production `.env` rotation is
# handled by GitHub Actions from the production environment secrets.

#--------------------------------------------------------------------
# App/runtime
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Europe/Paris'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
logger.threshold = 4

# Canonical public URL used in emails and absolute links.
kermesse.publicBaseURL = 'https://example.invalid/'

#--------------------------------------------------------------------
# Database: MariaDB/MySQL
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = kermesse
database.default.username = kermesse_user
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Optional local test database. Tests must not use production data.
# database.tests.hostname = localhost
# database.tests.database = kermesse_test
# database.tests.username = kermesse_test_user
# database.tests.password = change_me
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.port = 3306
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# Sessions and cookies
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = '/absolute/path/to/kermesse/writable/session'
session.cookieName = 'kermesse_session'
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false
cookie.prefix =
cookie.expires = 0
cookie.path = '/'
cookie.domain =
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# Email SMTP
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = smtp.example.invalid
email.SMTPUser = change_me
email.SMTPPass = change_me
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = 'no-reply@example.invalid'
email.fromName = 'Kermesse'

#--------------------------------------------------------------------
# Tokens
#--------------------------------------------------------------------

kermesse.tokenSecret = change_me_32_bytes_minimum
kermesse.ownerValidationTokenTTL = 86400
kermesse.ownerLoginTokenTTL = 900
kermesse.volunteerManagementTokenTTL = 1209600

#--------------------------------------------------------------------
# Ops migration runner
#--------------------------------------------------------------------

kermesse.opsMigrationHmacSecret = change_me_32_bytes_minimum
kermesse.opsMigrationAllowedTimestampSkew = 300
kermesse.opsMigrationNonceTTL = 600
kermesse.opsMigrationProductionOnly = true
kermesse.opsMigrationLockName = 'kermesse_ops_migration_lock'

#--------------------------------------------------------------------
# Deployment placeholders
#--------------------------------------------------------------------

kermesse.deployTarget = 'ouvaton'
kermesse.deployProtocol = '<ftps|sftp>'
kermesse.deployHost = 'example.invalid'
kermesse.deployRemotePath = '/path/to/kermesse'
kermesse.deployPreserveEnv = true
